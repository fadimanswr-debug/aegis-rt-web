def _interactive_shell(no_anim: bool = False) -> None:
    _tw_line(CYBER_BANNER)
    _spinner("Loading AEGIS-X-v1 modules", duration=0.35, no_anim=no_anim)
    _scan_bar(no_anim=no_anim)

    if not sys.stdin.isatty():
        _tw_line(f"{YELLOW}[!] Standard input is not an interactive TTY. Use subcommands like: aegis scan <sample>{RESET}")
        return

    eof_streak = 0
    while True:
        _render_menu(no_anim=no_anim)
        try:
            choice = input(f"\n{GREEN}{BOLD}aegis-rt>{RESET} ").strip()
            eof_streak = 0
        except KeyboardInterrupt:
            _tw_line(f"\n{DIM}Exiting Aegis-RT...{RESET}")
            break
        except EOFError:
            eof_streak += 1
            if eof_streak >= 3:
                _tw_line(f"\n{YELLOW}[!] Input stream closed (EOF). Exiting interactive shell.{RESET}")
                break
            time.sleep(0.05)
            continue

        try:
            if choice == "1":
                s = input(f"{CYAN}Sample:{RESET} ").strip()
                pw = input(f"{CYAN}Optional passphrase:{RESET} ").strip()
                _run_scan(s, pw, no_anim=no_anim)
            elif choice == "2":
                ct = input(f"{CYAN}Ciphertext:{RESET} ").strip()
                _run_caesar(ct or "khoor zruog", no_anim=no_anim)
            elif choice == "3":
                sub_mode = input(f"{CYAN}Mode (atbash/rot13/morse) [atbash]:{RESET} ").strip().lower() or "atbash"
                t = input(f"{CYAN}Input:{RESET} ").strip()
                if sub_mode == "rot13":
                    _run_rot13(t or "uryyb jbeyq", no_anim=no_anim)
                elif sub_mode == "morse":
                    _run_morse(t or ".... . .-.. .-.. ---", no_anim=no_anim)
                else:
                    _run_atbash(t or "svool dliow", no_anim=no_anim)
            elif choice == "4":
                ct = input(f"{CYAN}Vigenere ciphertext:{RESET} ").strip()
                _run_vigenere(ct, max_attempts=5000, timeout=5.0, no_anim=no_anim)
            elif choice == "5":
                s = input(f"{CYAN}Encoded sample:{RESET} ").strip()
                _run_layers(s, no_anim=no_anim)
            elif choice == "6":
                s = input(f"{CYAN}Hex or text sample:{RESET} ").strip()
                _run_xor_sb(s, no_anim=no_anim)
            elif choice == "7":
                s = input(f"{CYAN}Hex or text sample:{RESET} ").strip()
                _run_xor_rep(s, max_key_len=3, max_attempts=80000, timeout=5.0, no_anim=no_anim)
            elif choice == "8":
                h = input(f"{CYAN}Target hash:{RESET} ").strip()
                al = input(f"{CYAN}Algo (md5/sha1/sha256) [md5]:{RESET} ").strip() or "md5"
                _run_hash_lab(h, al, max_attempts=200000, timeout=8.0, no_anim=no_anim)
            elif choice == "9":
                txt = input(f"{CYAN}Payload text:{RESET} ").strip()
                pw = input(f"{CYAN}Passphrase:{RESET} ").strip()
                _run_tamper(txt or "red-team-note", pw or "StrongPass!2026", no_anim=no_anim)
            elif choice == "10":
                mode = input(f"{CYAN}Mode (wrap/unwrap) [wrap]:{RESET} ").strip().lower() or "wrap"
                payload = input(f"{CYAN}Text or Envelope:{RESET} ").strip()
                pw = input(f"{CYAN}Passphrase:{RESET} ").strip()
                if mode == "unwrap":
                    _run_unwrap(payload, pw, no_anim=no_anim)
                else:
                    _run_wrap(payload, pw, no_anim=no_anim)
            elif choice == "11":
                txt = input(f"{CYAN}Plaintext:{RESET} ").strip() or "sample-secret"
                pw = input(f"{CYAN}Passphrase:{RESET} ").strip() or "StrongPass!2026"
                _run_compare(txt, pw, no_anim=no_anim)
            elif choice == "0":
                _tw_line(f"{DIM}Session closed.{RESET}")
                break
            else:
                _tw_line(f"{YELLOW}[!] Invalid option.{RESET}\n")
        except ValueError as exc:
            _tw_line(f"\n{RED}{BOLD}[!] Error:{RESET} {exc}\n")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="aegis",
        description="Aegis-RT Interactive & Command-Line Crypto Analyzer"
    )
    parser.add_argument("--no-anim", action="store_true", help="Disable terminal animations")
    parser.add_argument("--json", action="store_true", help="Output raw JSON")
    parser.add_argument("--export", default="", help="Save output report to a file (.json or .txt)")
    sub = parser.add_subparsers(dest="command", required=False)

    p_scan = sub.add_parser("scan", help="Analyze pattern and detect vulnerabilities")
