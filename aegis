def typewriter_print(text, delay=0.01, enabled=True):
    if not enabled or not text:
        _tw_line(text)
        return
    s = str(text)
    if len(s) > 600:
        _tw_line(s)
        return
    for ch in s:
        print(ch, end="", flush=True)
        time.sleep(delay)
    print()

def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if not args.command:
        _interactive_shell(no_anim=args.no_anim)
        return 0
    try:
        args.func(args)
        return 0
    except ValueError as exc:
        print(f"\n{RED}{BOLD}[!] Error:{RESET} {exc}\n", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
