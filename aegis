def _tw_line(text, delay=0.004):
    s = str(text)
    if "\x1b[" in s or "\033[" in s or len(s) > 450:
        sys.stdout.write(s + "\n")
        sys.stdout.flush()
        return
    for ch in s:
        sys.stdout.write(ch)
        sys.stdout.flush()
        import time as _t
        _t.sleep(delay)
    sys.stdout.write("\n")
    sys.stdout.flush()
