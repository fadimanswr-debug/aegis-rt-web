def _render_scan_ui(report: dict, no_anim: bool = False) -> None:
    p = report.get("pattern", {})
    vulns = report.get("vulnerabilities", [])
    key_audit = report.get("key_audit")

    _tw_line(f"{BOLD}{MAGENTA}┌────────────────── CRYPTO AUDIT REPORT ──────────────────┐{RESET}")
    _scramble_reveal(f"{MAGENTA}│{RESET} {CYAN}Detected Type :{RESET} ", str(p.get("detected_type", "-")), no_anim=no_anim)
    _tw_line(f"{MAGENTA}│{RESET} {CYAN}Entropy       :{RESET} {YELLOW}{p.get('entropy', '-')} bits/char{RESET}  "
        f"{DIM}|{RESET}  {CYAN}Len:{RESET} {p.get('length', 0)}  "
        f"{DIM}|{RESET}  {CYAN}Unique:{RESET} {p.get('unique_char_ratio', 0)}")
    if key_audit:
        rating = key_audit.get("rating", "-")
        col = GREEN if rating == "Strong" else (YELLOW if rating == "Moderate" else RED)
        _tw_line(f"{MAGENTA}│{RESET} {CYAN}Key Strength  :{RESET} {col}{BOLD}{rating}{RESET} ({key_audit.get('score', 0)}/100)")
    _tw_line(f"{BOLD}{MAGENTA}└─────────────────────────────────────────────────────────┘{RESET}")

    if not vulns:
        _tw_line(f"\n  {GREEN}{BOLD}[✓] Target looks solid: no obvious cryptographic weaknesses found.{RESET}\n")
        return

    _tw_line(f"\n  {RED}{BOLD}[!] Detected Weaknesses ({len(vulns)}):{RESET}")
    for v in vulns:
        sev = v.get("severity", "Medium")
        tag = f"{RED}[HIGH]{RESET}" if sev == "High" else f"{YELLOW}[MED ]{RESET}"
        _tw_line(f"   {tag} {BOLD}{v.get('title')}{RESET} {DIM}({v.get('id')}){RESET}")
        _tw_line(f"         {DIM}{v.get('detail')}{RESET}")
        _tw_line(f"         {GREEN}Remediation:{RESET} {v.get('remediation')}")
    print()


