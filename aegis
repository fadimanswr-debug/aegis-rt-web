def _typewriter(text: str, delay: float = 0.004, no_anim: bool = False) -> None:
    if no_anim or not sys.stdout.isatty():
        _tw_line(text)
        return
    for ch in text:
        sys.stdout.write(ch)
        sys.stdout.flush()
        time.sleep(delay)
    print()


def _scramble_reveal(label: str, final_value: str, no_anim: bool = False) -> None:
    if no_anim or not sys.stdout.isatty() or not final_value:
        _tw_line(f"{label}{final_value}")
        return
    charset = "0123456789ABCDEF@#$%&*+?"
    shown = list(final_value)
    cycles = min(8, max(4, len(final_value) // 3))
    for step in range(cycles):
        temp = []
        for idx, ch in enumerate(shown):
            if ch in (" ", ":", "|", "-", "/"):
                temp.append(ch)
            elif idx < int((step / cycles) * len(shown)):
                temp.append(ch)
            else:
                temp.append(random.choice(charset))
        sys.stdout.write(f"\r{label}{CYAN}{''.join(temp)}{RESET}")
        sys.stdout.flush()
        time.sleep(0.02)
    sys.stdout.write(f"\r{label}{BOLD}{final_value}{RESET}\n")
    sys.stdout.flush()


def _spinner(label: str, duration: float = 0.35, no_anim: bool = False) -> None:
    if no_anim or not sys.stdout.isatty():
        _tw_line(f"[*] {label}")
        return
    frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    steps = max(1, int(duration / 0.05))
    for i in range(steps):
        f = frames[i % len(frames)]
        sys.stdout.write(f"\r{GREEN}{f}{RESET} {CYAN}{label}...{RESET}")
        sys.stdout.flush()
        time.sleep(0.05)
    sys.stdout.write(f"\r{GREEN}[✓]{RESET} {label}          \n")
    sys.stdout.flush()


def _scan_bar(no_anim: bool = False) -> None:
    if no_anim or not sys.stdout.isatty():
        return
    width = 26
    for i in range(width + 1):
        pct = int((i / width) * 100)
        bar = "█" * i + "░" * (width - i)
        sys.stdout.write(f"\r  {GREEN}[{bar}]{RESET} {CYAN}{pct:3d}%{RESET}")
        sys.stdout.flush()
        time.sleep(0.01)
    _tw_line("\n")


def _print_json(data: dict) -> None:
    _tw_line(json.dumps(data, indent=2, ensure_ascii=False))


def _save_export(data: dict, export_path: str) -> None:
    if not export_path:
        return
    target = Path(export_path).expanduser()
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.suffix.lower() == ".json":
        target.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    else:
        target.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    _tw_line(f"  {GREEN}[✓] Exported report to:{RESET} {target}\n")


